---
// "Shape it. Personalize it. Make it yours." — Caveat outlines (no font
// download) with a hand-sketched heart. Static: it fades in with the hero copy.
import { noteLines } from './note-glyphs';
---

<svg class="handnote" viewBox="0 0 230 150" role="img" aria-labelledby="handnote-t">
  <title id="handnote-t">Shape it. Personalize it. Make it yours.</title>
  {noteLines.map((l) => <path class="hn-line" d={l.d} />)}
  <path class="hn-doodle" d="M213 108c-5-8-16-3-11 6 2 4 8 7 11 10 3-3 9-6 11-10 5-9-6-14-11-6zM207 82l-3-7M215 79v-8M223 82l3-7"></path>
</svg>

<style is:global>
  .handnote {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .hn-line {
    fill: var(--terracotta);
  }
  .hn-doodle {
    fill: none;
    stroke: var(--terracotta);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
