---
import MiniMark from './MiniMark.astro';
import Icon from './Icon.astro';
import { site, waLink } from '../data/site';
---

<footer class="site-footer">
  <div class="site-footer__inner" data-reveal>
    <MiniMark size={56} />
    <p class="site-footer__word">Studio <span>akaar</span></p>
    <p class="site-footer__tag">Create · Connect · Express</p>
    <div class="site-footer__links">
      <a class="pill" href="/#workshops"><Icon name="vase" size={16} /> Workshops</a>
      <a class="pill" href={waLink('Hi Studio Akaar! I’d like to know more about your workshops.')} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={16} /> WhatsApp
      </a>
      {
        site.instagram && (
          <a class="pill" href={site.instagram} target="_blank" rel="noopener">
            <Icon name="instagram" size={16} /> Instagram
          </a>
        )
      }
    </div>
    <p class="site-footer__fine">© {new Date().getFullYear()} Studio Akaar. Handmade with clay, colour & care.</p>
  </div>
</footer>

<style is:global>
  .site-footer {
    position: relative;
    z-index: 1;
    margin-top: 72px;
    padding: 56px var(--gutter) 40px;
    background: var(--ink);
    color: var(--cream);
    border-radius: 36px 36px 0 0;
    text-align: center;
  }
  .site-footer__inner {
    display: grid;
    justify-items: center;
    gap: 6px;
    max-width: 560px;
    margin: 0 auto;
  }
  /* The charcoal crescent would vanish on the dark footer. */
  .site-footer .minimark path:nth-child(2) {
    fill: var(--cream);
  }
  .site-footer__word {
    margin: 10px 0 0;
    font: 600 0.75rem/1 var(--sans);
    letter-spacing: 0.4em;
    text-transform: uppercase;
  }
  .site-footer__word span {
    display: block;
    margin-top: 4px;
    font: 600 2.6rem/1 var(--serif);
    letter-spacing: 0.3em;
    text-transform: none;
  }
  .site-footer__tag {
    margin: 0;
    font: 600 0.66rem/1 var(--sans);
    letter-spacing: 0.24em;
    color: var(--ochre);
  }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 22px;
  }
  .site-footer .pill {
    min-height: 40px;
    padding-inline: 1em;
    background: transparent;
    color: var(--cream);
    border-color: rgb(250 243 235 / 0.25);
    text-decoration: none;
  }
  .site-footer .pill:hover {
    background: var(--cream);
    color: var(--ink);
  }
  .site-footer__fine {
    margin: 26px 0 0;
    font-size: 0.75rem;
    color: rgb(250 243 235 / 0.55);
  }
</style>
