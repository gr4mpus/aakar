---
import Stamp from './Stamp.astro';
import Icon from '../Icon.astro';
import { categories, img, srcset, inr, type Workshop } from '../../data/workshops';

interface Props {
  w: Workshop;
  index: number;
}
const { w, index } = Astro.props;
const num = String(index + 1).padStart(2, '0');
const photo = w.photos[0];
---

<article
  class={`ws-card shape-${index % 5}`}
  data-cat={w.category}
  data-reveal
  style={`--accent: var(--${w.accent}); --d:${(index % 2) * 90}`}
>
  <div class="ws-photo" data-parallax>
    <span class="ws-photo__blob"></span>
    <div class="ws-photo__frame" style={`view-transition-name: ws-${w.slug}`}>
      <img
        src={img(photo, 720, 540)}
        style={photo.pos && `object-position:${photo.pos}`}
        srcset={srcset(photo, 0.75)}
        sizes="(min-width: 900px) 520px, 92vw"
        width="720"
        height="540"
        alt={`${w.title} workshop at Studio Akaar — ${photo.caption.toLowerCase()}`}
        loading={index < 1 ? 'eager' : 'lazy'}
        decoding="async"
      />
    </div>
    <Stamp id={w.slug} text={w.stamp} center={num} class="ws-photo__stamp" />
    <span class="ws-photo__stock">{w.stock} in stock</span>
  </div>

  <div class="ws-body">
    <div class="ws-meta">
      <span class="ws-cat">{categories[w.category]}</span>
      <span class="pill"><Icon name="users" size={14} /> {w.audience}</span>
    </div>
    <h3 class="ws-title">
      <a class="ws-link" href={`/workshops/${w.slug}/`}>{w.title}</a>
    </h3>
    <svg class="brushline" viewBox="0 0 280 10" preserveAspectRatio="none" aria-hidden="true">
      <path pathLength="1" d="M2 6Q95 1 190 6T276 4"></path>
    </svg>
    <p class="ws-summary">{w.summary}</p>
    <ul class="ws-tags" data-stagger>
      {w.tags.map((t) => <li>{t}</li>)}
    </ul>
    <div class="ws-foot">
      <span class="ws-dur"><Icon name="clock" size={16} /> {w.duration.replace(' session', '')}</span>
      <span class="ws-price">
        <del>{inr(w.mrp)}</del>
        <strong>{inr(w.price)}</strong>
      </span>
      <span class="ws-cta" aria-hidden="true">Book <Icon name="arrow" size={16} /></span>
    </div>
  </div>
</article>

<style is:global>
  .ws-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 14px 14px 18px;
    border-radius: var(--radius);
    background: rgb(239 226 211 / 0.85);
    border: 1px solid rgb(169 53 24 / 0.14);
    transition:
      box-shadow 0.5s var(--ease-out),
      scale 0.3s var(--ease-out);
  }
  @media (hover: hover) {
    .ws-card:hover {
      box-shadow: 0 26px 50px -30px rgb(28 27 25 / 0.55);
    }
    .ws-card:hover .ws-photo__frame img {
      scale: 1.06;
    }
    .ws-card:hover .ws-cta {
      background: var(--ink);
    }
    .ws-card:hover .ws-cta .icon {
      transform: translateX(4px);
    }
  }
  .ws-card:active {
    scale: 0.99;
  }

  /* Organic clay-mask photo */
  .ws-photo {
    position: relative;
    aspect-ratio: 4 / 3;
    margin: 4px 4px 0;
  }
  .ws-photo__blob,
  .ws-photo__frame {
    position: absolute;
    inset: 0;
    border-radius: var(--shape);
  }
  .ws-photo__blob {
    background: var(--accent);
    opacity: 0.22;
    border-radius: var(--shape-alt);
    transform: rotate(-4deg) translate(6px, 8px);
    transition: transform 1.1s var(--ease-out) 0.15s;
  }
  .js .ws-card:not(.in) .ws-photo__blob {
    transform: rotate(6deg) translate(-4px, 14px) scale(0.92);
  }
  .ws-photo__frame {
    overflow: hidden;
    background: var(--sand-deep);
    /* WebKit drops rounded clipping on moving children without this. */
    isolation: isolate;
    -webkit-mask-image: -webkit-radial-gradient(white, black);
  }
  .ws-photo__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.14) translateY(calc(var(--py, 0) * -6%));
    transition: scale 0.8s var(--ease-out);
  }
  .shape-0 { --shape: 46% 54% 40% 60% / 55% 45% 55% 45%; --shape-alt: 58% 42% 52% 48% / 44% 58% 42% 56%; }
  .shape-1 { --shape: 38% 62% 56% 44% / 48% 40% 60% 52%; --shape-alt: 50% 50% 40% 60% / 60% 46% 54% 40%; }
  .shape-2 { --shape: 999px 999px 26px 26px / 520px 520px 26px 26px; --shape-alt: 999px 999px 40px 40px / 480px 480px 40px 40px; }
  .shape-3 { --shape: 30px 130px 30px 130px; --shape-alt: 120px 30px 120px 30px; }
  .shape-4 { --shape: 52% 48% 44% 56% / 62% 58% 42% 38%; --shape-alt: 44% 56% 58% 42% / 50% 62% 38% 50%; }

  .ws-photo__stamp {
    top: -14px;
    right: -6px;
  }
  .ws-photo__stock {
    position: absolute;
    left: 10px;
    bottom: 12px;
    padding: 5px 11px;
    border-radius: 999px;
    background: var(--cream);
    color: var(--terracotta);
    font: 800 0.68rem/1 var(--sans);
    letter-spacing: 0.04em;
    box-shadow: 0 6px 16px -8px rgb(28 27 25 / 0.5);
  }

  .ws-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 16px 6px 0;
  }
  .ws-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .ws-title {
    margin: 12px 0 0;
    font: 600 clamp(1.7rem, 7cqw, 2.2rem) / 1.02 var(--serif);
  }
  .ws-link {
    text-decoration: none;
  }
  .ws-link::after {
    /* stretched link: the whole card is clickable */
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: var(--radius);
  }
  .ws-summary {
    margin: 10px 0 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .ws-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .ws-tags li {
    padding: 4px 10px;
    border-radius: 10px;
    background: var(--cream);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .ws-foot {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px dashed rgb(169 53 24 / 0.22);
    margin-block-start: 18px;
  }
  .ws-dur {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--olive);
  }
  .ws-price {
    display: grid;
    margin-left: auto;
    text-align: right;
    line-height: 1;
  }
  .ws-price del {
    font-size: 0.72rem;
    color: rgb(28 27 25 / 0.45);
  }
  .ws-price strong {
    font: 600 1.45rem/1 var(--serif);
    color: var(--terracotta);
  }
  .ws-cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    background: var(--terracotta);
    color: var(--cream);
    font: 700 0.8rem/1 var(--sans);
    transition: background 0.3s;
  }
  .ws-cta .icon {
    transition: transform 0.3s var(--ease-out);
  }
</style>
