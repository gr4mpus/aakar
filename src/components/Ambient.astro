---
// Page-wide ambient art: a terracotta thread that draws itself with scroll,
// and olive branches that bloom in the margins as they enter the viewport.
const branches = Array.from({ length: 12 }, (_, i) => {
  const left = i % 2 === 0;
  return {
    left,
    top: 4 + i * 8 + (i % 3) * 1.5, // % of page height
    size: 74 + ((i * 37) % 46), // px
    tilt: (left ? 1 : -1) * (14 + ((i * 11) % 22)),
    flip: left ? 1 : -1,
  };
});
---

<div class="ambient" aria-hidden="true">
  <svg class="thread" viewBox="0 0 100 1000" preserveAspectRatio="none">
    <path
      pathLength="1"
      d="M50,0 C68,180 32,360 54,540 C72,720 30,860 50,1000"></path>
  </svg>
  <!-- Phones: two soft clay glows that drift slowly with scroll. -->
  <div class="wash" data-progress>
    <span class="wash__a"></span>
    <span class="wash__b"></span>
  </div>
  <div class="branches">
    {
      branches.map((b) => (
        <span
          class="branch"
          data-reveal
          style={`top:${b.top}%;${b.left ? 'left' : 'right'}:-18px;--s:${b.size}px;--tilt:${b.tilt}deg;--flip:${b.flip}`}
        >
          <svg viewBox="0 0 80 160">
            <use href="#i-branch" />
          </svg>
        </span>
      ))
    }
  </div>
</div>

<style is:global>
  .ambient {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .thread {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
  }
  .thread path {
    fill: none;
    stroke: var(--terracotta);
    stroke-width: 1.4;
    opacity: 0.24;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1 1;
    stroke-dashoffset: calc(1px - var(--p, 0) * 1px);
  }
  .branches {
    position: absolute;
    inset: 0;
  }

  /* ----- Phones: the thread hides behind cards, so instead two soft clay
     glows drift a little as you scroll. Gradients only (no blur filter), and
     only transform changes, so it costs almost nothing. ----- */
  .wash {
    display: none;
  }
  @media (max-width: 759px) {
    .thread {
      display: none;
    }
    .wash {
      display: block;
      position: fixed;
      inset: 0;
      overflow: hidden;
    }
    .wash span {
      position: absolute;
      width: 120vw;
      height: 120vw;
      border-radius: 50%;
    }
    .wash__a {
      top: -30vw;
      right: -55vw;
      background: radial-gradient(closest-side, rgb(226 140 31 / 0.16), transparent);
      transform: translate3d(calc(var(--p, 0) * -40vw), calc(var(--p, 0) * 70vh), 0);
    }
    .wash__b {
      bottom: -40vw;
      left: -60vw;
      background: radial-gradient(closest-side, rgb(169 53 24 / 0.11), transparent);
      transform: translate3d(calc(var(--p, 0) * 35vw), calc(var(--p, 0) * -60vh), 0);
    }
  }
  .branch {
    position: absolute;
    width: var(--s);
    color: var(--olive);
    opacity: 0.15;
    transform: scaleX(var(--flip)) rotate(var(--tilt));
  }
  .branch svg {
    width: 100%;
    height: auto;
    transform-origin: 50% 100%;
    transition: transform 1.6s var(--ease-out);
  }
  /* Bloom: the branch, not its wrapper, so the reveal opacity stays subtle. */
  .js .branch[data-reveal] {
    opacity: 0;
    transform: scaleX(var(--flip)) rotate(var(--tilt));
    transition: opacity 1.2s var(--ease-out);
  }
  .js .branch[data-reveal] svg {
    transform: scale(0.28) rotate(-18deg);
  }
  .js .branch[data-reveal].in {
    opacity: 0.15;
  }
  .js .branch[data-reveal].in svg {
    transform: none;
  }
  @media (min-width: 900px) {
    .branch {
      --s: 120px !important;
    }
  }
</style>
