---
// Page-wide ambient art: a terracotta thread that draws itself with scroll,
// and olive branches that bloom in the margins as they enter the viewport.
const branches = Array.from({ length: 12 }, (_, i) => {
  const left = i % 2 === 0;
  return {
    left,
    top: 4 + i * 8 + (i % 3) * 1.5, // % of page height
    size: 74 + ((i * 37) % 46), // px
    tilt: (left ? 1 : -1) * (14 + ((i * 11) % 22)),
    flip: left ? 1 : -1,
  };
});
---

<div class="ambient" aria-hidden="true">
  <svg class="thread" viewBox="0 0 100 1000" preserveAspectRatio="none">
    <path
      pathLength="1"
      d="M50,0 C68,180 32,360 54,540 C72,720 30,860 50,1000"></path>
  </svg>
  <!-- Mobile: a brush stroke that paints itself down the left gutter. -->
  <div class="rail" data-progress>
    <span class="rail__stroke"></span>
    <span class="rail__drip"></span>
  </div>
  <div class="branches">
    {
      branches.map((b) => (
        <span
          class="branch"
          data-reveal
          style={`top:${b.top}%;${b.left ? 'left' : 'right'}:-18px;--s:${b.size}px;--tilt:${b.tilt}deg;--flip:${b.flip}`}
        >
          <svg viewBox="0 0 80 160">
            <use href="#i-branch" />
          </svg>
        </span>
      ))
    }
  </div>
</div>

<style is:global>
  .ambient {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: clip;
  }
  .thread {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
  }
  .thread path {
    fill: none;
    stroke: var(--terracotta);
    stroke-width: 1.4;
    opacity: 0.24;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1 1;
    stroke-dashoffset: calc(1px - var(--p, 0) * 1px);
  }
  .branches {
    position: absolute;
    inset: 0;
  }

  /* ----- Mobile scroll accent (the centre thread hides behind cards on phones).
     Left side, because the browser's scrollbar lives on the right. ----- */
  .rail {
    --rail-h: calc(100svh - 110px);
    position: fixed;
    top: 84px;
    left: 5px;
    z-index: 25;
    width: 6px;
    height: var(--rail-h);
    pointer-events: none;
    /* Hidden at the top so the hero stays clean; eases in once scrolling starts. */
    opacity: min(0.75, calc(var(--p, 0) * 25));
    transition: opacity 0.5s;
  }
  .rail__stroke {
    /* tapered like a loaded brush: thin and faint at the start, full at the tip */
    position: absolute;
    left: 2px;
    top: 0;
    width: 2.5px;
    height: 100%;
    border-radius: 3px;
    background: linear-gradient(rgb(226 140 31 / 0), var(--ochre) 18%, var(--terracotta));
    transform-origin: 50% 0;
    transform: scaleY(var(--p, 0));
  }
  .rail__drip {
    /* a soft drop of wet slip at the end of the stroke */
    position: absolute;
    left: 0.5px;
    top: -5px;
    width: 5.5px;
    height: 8px;
    border-radius: 50% 50% 50% 50% / 40% 40% 60% 60%;
    background: var(--terracotta);
    transform: translateY(calc(var(--p, 0) * var(--rail-h)));
  }
  @media (min-width: 760px) {
    .rail {
      display: none;
    }
  }
  @media (max-width: 759px) {
    .thread {
      display: none;
    }
  }
  .branch {
    position: absolute;
    width: var(--s);
    color: var(--olive);
    opacity: 0.15;
    transform: scaleX(var(--flip)) rotate(var(--tilt));
  }
  .branch svg {
    width: 100%;
    height: auto;
    transform-origin: 50% 100%;
    transition: transform 1.6s var(--ease-out);
  }
  /* Bloom: the branch, not its wrapper, so the reveal opacity stays subtle. */
  .js .branch[data-reveal] {
    opacity: 0;
    transform: scaleX(var(--flip)) rotate(var(--tilt));
    transition: opacity 1.2s var(--ease-out);
  }
  .js .branch[data-reveal] svg {
    transform: scale(0.28) rotate(-18deg);
  }
  .js .branch[data-reveal].in {
    opacity: 0.15;
  }
  .js .branch[data-reveal].in svg {
    transform: none;
  }
  @media (min-width: 900px) {
    .branch {
      --s: 120px !important;
    }
  }
</style>
